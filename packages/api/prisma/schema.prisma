generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id            String         @id @default(cuid())
  name          String
  inviteCode    String         @unique
  createdAt     DateTime       @default(now())

  // â”€â”€ Premium / billing â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  plan          String         @default("free")       // "free" | "plus" | "pro"
  stripeCustomerId  String?    @unique
  stripeSubId       String?    @unique
  planExpiresAt     DateTime?

  members       Member[]
  chores        Chore[]
  meals         Meal[]
  events        Event[]
  rewards       Reward[]
  messages      Message[]
  quests        Quest[]
  notifications Notification[]
  automations   Automation[]
  memories      Memory[]
  groceryItems  GroceryItem[]
}

model Member {
  id              String       @id @default(cuid())
  familyId        String
  family          Family       @relation(fields: [familyId], references: [id])
  name            String
  emoji           String       @default("ðŸ™‚")
  color           String       @default("#6366F1")
  avatarUrl       String?
  role            String       @default("child")      // "parent" | "child"
  stars           Int          @default(0)
  password        String
  email           String?
  pushToken       String?
  createdAt       DateTime     @default(now())

  // â”€â”€ Gamification â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  streakDays      Int          @default(0)
  streakUpdatedAt DateTime?
  totalChoresDone Int          @default(0)
  badges          String[]     @default([])

  // â”€â”€ Location / safety â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime?

  chores          Chore[]      @relation("AssignedChores")
  completedChores Chore[]      @relation("CompletedChores")
  meals           Meal[]
  events          Event[]
  messages        Message[]
  redemptions     Redemption[]
  groceryAdded    GroceryItem[] @relation("GroceryAdded")
}

enum ChoreStatus {
  pending
  in_progress
  done
}

model Chore {
  id            String    @id @default(cuid())
  familyId      String
  family        Family    @relation(fields: [familyId], references: [id])
  title         String
  emoji         String    @default("âœ…")
  assignedToId  String?
  assignedTo    Member?   @relation("AssignedChores", fields: [assignedToId], references: [id])
  frequency     String    @default("daily")
  stars         Int       @default(5)
  status       ChoreStatus @default(pending)
  status        String    @default("pending")   // "pending" | "in_progress" | "done"
  proofRequired Boolean   @default(false)
  proofUrl      String?
  proofType     String?
  dueDate       DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   Member?   @relation("CompletedChores", fields: [completedById], references: [id])
  createdAt     DateTime  @default(now())
}

model Meal {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  day          String
  slot         String   @default("dinner")
  name         String
  emoji        String   @default("ðŸ½ï¸")
  notes        String?
  assignedToId String?
  assignedTo   Member?  @relation(fields: [assignedToId], references: [id])
  week         String
  createdAt    DateTime @default(now())
}

model Event {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  title        String
  emoji        String   @default("ðŸ“…")
  date         DateTime
  time         String?
  color        String?
  notes        String?
  assignedToId String?
  assignedTo   Member?  @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
}

model Reward {
  id             String       @id @default(cuid())
  familyId       String
  family         Family       @relation(fields: [familyId], references: [id])
  name           String
  emoji          String       @default("ðŸŽ")
  cost           Int
  description    String?
  availableCount Int?
  redemptions    Redemption[]
  createdAt      DateTime     @default(now())
}

model Redemption {
  id        String   @id @default(cuid())
  familyId  String
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  text      String?
  mediaUrl  String?
  mediaType String?
  replyToId String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Quest {
  id          String    @id @default(cuid())
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id])
  title       String
  description String?
  emoji       String    @default("âš”ï¸")
  type        String    @default("family")
  goal        Int       @default(5)
  progress    Int       @default(0)
  reward      Int       @default(10)
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  memberId  String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Automation {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id])
  name       String
  trigger    String
  conditions Json     @default("{}")
  actions    Json     @default("[]")
  active     Boolean  @default(true)
  lastRanAt  DateTime?
  createdAt  DateTime @default(now())
}

model Memory {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  title     String
  body      String?
  mediaUrl  String?
  mediaType String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model GroceryItem {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id])
  addedById   String
  addedBy     Member   @relation("GroceryAdded", fields: [addedById], references: [id])
  name        String
  qty         String?
  category    String   @default("General")
  checked     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

