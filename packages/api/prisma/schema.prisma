generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id               String          @id @default(cuid())
  name             String
  inviteCode       String          @unique
  googleTokens  String?
  aiConsentAt      DateTime?
  aiConsentById    String?
  // Parent's acceptance of the terms/privacy policy and consent for children's data.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  termsAcceptedById String?
  childConsentAt    DateTime?
  createdAt        DateTime        @default(now())
  plan             String          @default("free")
  stripeCustomerId String?         @unique
  stripeSubId      String?         @unique
  planExpiresAt    DateTime?
  members          Member[]
  chores           Chore[]
  meals            Meal[]
  events           Event[]
  rewards          Reward[]
  messages         Message[]
  quests           Quest[]
  notifications    Notification[]
  automations      Automation[]
  memories         Memory[]
  groceryItems     GroceryItem[]
  weeklyRules      WeeklyRule[]
  triviaSessions   TriviaSession[]
  gameScores       GameScore[]
  trips            Trip[]
  choreCompletions ChoreCompletion[]
  auditLogs        AuditLog[]
  achievements     Achievement[]
  goals            FamilyGoal[]
}

model Member {
  id              String         @id @default(cuid())
  familyId        String
  family          Family         @relation(fields: [familyId], references: [id])
  name            String
  emoji           String         @default("🙂")
  color           String         @default("#6366F1")
  avatarUrl       String?
  role            String         @default("child")
  stars           Int            @default(0)
  // Every star ever earned (never goes down when stars are spent). Drives levels.
  lifetimeStars   Int            @default(0)
  achievements    Achievement[]
  password        String
  tokenVersion    Int            @default(0)
  email           String?
  emailVerifiedAt DateTime?
  authTokens      AuthToken[]
  rewardGoalId String?
  canOpenPersonalOS Boolean @default(false)
  canOpenPremed Boolean @default(false)
  pushToken       String?
  webPushSubscriptions WebPushSubscription[]
  messageAcknowledgements MessageAcknowledgement[]
  messagePollVotes MessagePollVote[]
  createdAt       DateTime       @default(now())
  birthday        DateTime?
  wishlist        WishlistItem[]
  streakDays      Int            @default(0)
  streakUpdatedAt DateTime?
  totalChoresDone Int            @default(0)
  badges          String[]       @default([])
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime?
  chores          Chore[]        @relation("AssignedChores")
  completedChores Chore[]        @relation("CompletedChores")
  choreAssignments Chore[]       @relation("ChoreAssignees")
  mealAssignments Meal[]         @relation("MealAssignees")
  meals           Meal[]
  events          Event[]
  messages        Message[]
  redemptions     Redemption[]
  quests          Quest[]
  groceryAdded    GroceryItem[]  @relation("GroceryAdded")
  rulesAsTarget   WeeklyRule[]   @relation("RuleTarget")
  rulesCreated    WeeklyRule[]   @relation("RuleCreator")
  ruleOutcomes    RuleOutcome[]
  triviaAnswers   TriviaAnswer[]
  gameScores      GameScore[]
  tripsCreated    Trip[]               @relation("TripCreator")
  packingItems    PackingItem[]        @relation("PackingItems")
  activityAssignments  ItineraryActivity[]  @relation("ActivityAssignees")
  choreCompletions     ChoreCompletion[]
}

enum ChoreStatus {
  pending
  in_progress
  done
  review
}

model Chore {
  archivedAt DateTime?
  id            String      @id @default(cuid())
  familyId      String
  family        Family      @relation(fields: [familyId], references: [id])
  title         String
  emoji         String      @default("✅")
  assignedToId  String?
  assignedTo    Member?     @relation("AssignedChores", fields: [assignedToId], references: [id])
  assignees     Member[]    @relation("ChoreAssignees")
  frequency     String      @default("daily")
  stars         Int         @default(5)
  status        ChoreStatus @default(pending)
  proofRequired Boolean     @default(false)
  proofUrl      String?
  proofType     String?
  priority      String      @default("normal")
  notes         String?
  dueDate       DateTime?
  completedAt   DateTime?
  // Photo-proof flow: a kid submits, a parent approves (stars land) or sends it back.
  submittedAt   DateTime?
  submittedById String?
  reviewNote    String?
  photoUrl      String?
  photoedAt     DateTime?
  completedById String?
  completedBy   Member?     @relation("CompletedChores", fields: [completedById], references: [id])
  recurring     Boolean     @default(false)
  weeklyStreak  Int         @default(0)
  createdAt     DateTime    @default(now())
}

model Meal {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  day          String
  slot         String   @default("dinner")
  name         String
  emoji        String   @default("🍽️")
  notes        String?
  assignedToId String?
  assignedTo   Member?  @relation(fields: [assignedToId], references: [id])
  assignees    Member[] @relation("MealAssignees")
  week         String
  createdAt    DateTime @default(now())
}
model Event {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  title        String
  emoji        String   @default("📅")
  date         DateTime
  time         String?
  color        String?
  notes        String?
  assignedToId String?
  assignedTo   Member?  @relation(fields: [assignedToId], references: [id])
  googleEventId String?
  source        String?  @default("app")
  createdAt    DateTime @default(now())
}

model Reward {
  id             String       @id @default(cuid())
  familyId       String
  family         Family       @relation(fields: [familyId], references: [id])
  name           String
  emoji          String       @default("🎁")
  cost           Int
  description    String?
  availableCount Int?
  redemptions    Redemption[]
  createdAt      DateTime     @default(now())
}

model Redemption {
  id        String   @id @default(cuid())
  familyId  String
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  rewardId  String
  status    String   @default("pending")
  reward    Reward   @relation(fields: [rewardId], references: [id])
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  text      String?
  mediaUrl  String?
  mediaType String?
  replyToId String?
  pollQuestion String?
  pollOptions String[] @default([])
  acknowledgements MessageAcknowledgement[]
  votes MessagePollVote[]
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Quest {
  id          String    @id @default(cuid())
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id])
  memberId    String?
  member      Member?   @relation(fields: [memberId], references: [id])
  title       String
  description String?
  emoji       String    @default("⚡")
  difficulty  String    @default("easy")
  stages      Json      @default("[]")
  stars       Int       @default(10)
  reward      Int       @default(10)
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  memberId  String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Automation {
  id         String    @id @default(cuid())
  familyId   String
  family     Family    @relation(fields: [familyId], references: [id])
  name       String
  trigger    String
  conditions Json      @default("{}")
  actions    Json      @default("[]")
  active     Boolean   @default(true)
  lastRanAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Memory {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  title     String
  body      String?
  mediaUrl  String?
  mediaType String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model GroceryItem {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  addedById String
  addedBy   Member   @relation("GroceryAdded", fields: [addedById], references: [id])
  name      String
  qty       String?
  category  String   @default("General")
  listType  String   @default("grocery")
  priority  String   @default("normal")
  notes     String?
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WeeklyRule {
  id              String        @id @default(cuid())
  familyId        String
  family          Family        @relation(fields: [familyId], references: [id])
  assignedToId    String
  assignedTo      Member        @relation("RuleTarget",  fields: [assignedToId], references: [id])
  createdById     String
  createdBy       Member        @relation("RuleCreator", fields: [createdById],  references: [id])
  label           String
  minStars        Int
  consequence     String        @default("reduce_screen_time")
  consequenceNote String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  outcomes        RuleOutcome[]
}

model RuleOutcome {
  id          String     @id @default(cuid())
  ruleId      String
  rule        WeeklyRule @relation(fields: [ruleId], references: [id])
  memberId    String
  member      Member     @relation(fields: [memberId], references: [id])
  weekStart   String
  starsEarned Int
  passed      Boolean
  notified    Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model TriviaSession {
  id        String           @id @default(cuid())
  familyId  String
  family    Family           @relation(fields: [familyId], references: [id])
  status    String           @default("pending")
  createdAt DateTime         @default(now())
  questions TriviaQuestion[]
  answers   TriviaAnswer[]
}

model TriviaQuestion {
  id        String         @id @default(cuid())
  sessionId String
  session   TriviaSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question  String
  options   String[]
  answer    String
  order     Int
  answers   TriviaAnswer[]
}

model TriviaAnswer {
  id         String         @id @default(cuid())
  sessionId  String
  session    TriviaSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   TriviaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id])
  answer     String
  correct    Boolean
  createdAt  DateTime       @default(now())
}

model GameScore {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  gameType  String
  score     Int
  playedAt  DateTime @default(now())

  @@index([familyId, gameType])
}
model WishlistItem {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title      String
  url        String?
  price      Float?
  claimed    Boolean  @default(false)
  claimedBy  String?
  status      String   @default("open")
  declineReason String?
  deferUntil  DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt  DateTime @default(now())
}

model Trip {
  id            String         @id @default(cuid())
  familyId      String
  family        Family         @relation(fields: [familyId], references: [id])
  title         String
  destination   String?
  startDate     DateTime
  endDate       DateTime
  notes         String?
  createdById   String
  createdBy     Member         @relation("TripCreator", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  packingItems  PackingItem[]
  itineraryDays ItineraryDay[]
}

model PackingItem {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation("PackingItems", fields: [memberId], references: [id])
  name      String
  quantity  Int      @default(1)
  category  String?
  packed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ItineraryDay {
  id         String              @id @default(cuid())
  tripId     String
  trip       Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date       DateTime
  title      String?
  notes      String?
  activities ItineraryActivity[]
}

model ItineraryActivity {
  id        String       @id @default(cuid())
  dayId     String
  day       ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  title     String
  time      String?
  location  String?
  notes     String?
  assignees Member[]     @relation("ActivityAssignees")
  createdAt DateTime     @default(now())
}
model WebPushSubscription {
  id String @id @default(cuid())
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  tasks Boolean @default(true)
  rewards Boolean @default(true)
  chat Boolean @default(true)
  createdAt DateTime @default(now())
}

model MessageAcknowledgement {
 id String @id @default(cuid())
 messageId String
 message Message @relation(fields:[messageId], references:[id], onDelete:Cascade)
 memberId String
 member Member @relation(fields:[memberId], references:[id], onDelete:Cascade)
 kind String
 @@unique([messageId, memberId])
}
model MessagePollVote {
 id String @id @default(cuid())
 messageId String
 message Message @relation(fields:[messageId], references:[id], onDelete:Cascade)
 memberId String
 member Member @relation(fields:[memberId], references:[id], onDelete:Cascade)
 optionIndex Int
 @@unique([messageId, memberId])
}

// One row per member per chore completion: the stars that member actually received.
// Not linked to Chore by foreign key, so history survives when a daily chore is recycled.
// Undoing a completion removes these rows and takes the same stars back, so
// done -> pending -> done can never award stars twice.
model ChoreCompletion {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  choreId     String
  choreTitle  String
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  stars       Int
  completedAt DateTime
  createdAt   DateTime @default(now())

  @@index([familyId, completedAt])
  @@index([choreId, completedAt])
}

// Who did what, for parents. Never stores passwords, tokens or message text.
model AuditLog {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actorId    String?
  actorName  String
  action     String
  targetType String?
  targetId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([familyId, createdAt])
}

// One-time links sent by email (verify address, reset password).
// Only a SHA-256 hash of the token is stored; the link itself is never saved.
model AuthToken {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, purpose])
}

// Badges and level-ups, with the moment they happened (for celebrations and Weekly Wins).
model Achievement {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind      String   // "badge" | "level"
  code      String   // badge code, or the level number
  label     String
  createdAt DateTime @default(now())

  @@index([familyId, createdAt])
  @@unique([memberId, kind, code])
}

// A shared target the whole family works toward ("500 stars = pizza and movie night").
// Progress = stars everyone earns from chores and quests since the goal started.
model FamilyGoal {
  id          String    @id @default(cuid())
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title       String
  emoji       String    @default("🎯")
  reward      String?
  targetStars Int
  startsAt    DateTime  @default(now())
  reachedAt   DateTime?
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([familyId, archivedAt])
}
