generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id            String         @id @default(cuid())
  name          String
  inviteCode    String         @unique
  createdAt     DateTime       @default(now())

  // ── Premium / billing ──────────────────────────────────────────────────────
  plan          String         @default("free")       // "free" | "plus" | "pro"
  stripeCustomerId  String?    @unique
  stripeSubId       String?    @unique
  planExpiresAt     DateTime?

  members       Member[]
  chores        Chore[]
  meals         Meal[]
  events        Event[]
  rewards       Reward[]
  messages      Message[]
  quests        Quest[]
  notifications Notification[]
  automations   Automation[]
  memories      Memory[]
}

model Member {
  id              String       @id @default(cuid())
  familyId        String
  family          Family       @relation(fields: [familyId], references: [id])
  name            String
  emoji           String       @default("🙂")
  color           String       @default("#6366F1")
  avatarUrl       String?
  role            String       @default("child")      // "parent" | "child"
  stars           Int          @default(0)
  password        String
  email           String?
  pushToken       String?
  createdAt       DateTime     @default(now())

  // ── Gamification ──────────────────────────────────────────────────────────
  streakDays      Int          @default(0)            // current daily chore streak
  streakUpdatedAt DateTime?                           // last day streak was incremented
  totalChoresDone Int          @default(0)            // all-time completions
  badges          String[]     @default([])           // e.g. ["first_chore","streak_7"]

  // ── Location / safety ─────────────────────────────────────────────────────
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime?

  chores          Chore[]      @relation("AssignedChores")
  completedChores Chore[]      @relation("CompletedChores")
  meals           Meal[]
  events          Event[]
  messages        Message[]
  redemptions     Redemption[]
}

model Chore {
  id            String    @id @default(cuid())
  familyId      String
  family        Family    @relation(fields: [familyId], references: [id])
  title         String
  emoji         String    @default("✅")
  assignedToId  String?
  assignedTo    Member?   @relation("AssignedChores", fields: [assignedToId], references: [id])
  frequency     String    @default("daily")           // "daily" | "weekly" | "once"
  stars         Int       @default(5)
  done          Boolean   @default(false)
  proofRequired Boolean   @default(false)
  proofUrl      String?
  proofType     String?   // "image" | "video"
  dueDate       DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   Member?   @relation("CompletedChores", fields: [completedById], references: [id])
  createdAt     DateTime  @default(now())
}

model Meal {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  day          String
  slot         String   @default("dinner")            // "breakfast"|"lunch"|"dinner"|"snack"
  name         String
  emoji        String   @default("🍽️")
  notes        String?
  assignedToId String?
  assignedTo   Member?  @relation(fields: [assignedToId], references: [id])
  week         String                                 // ISO date of Monday e.g. "2026-05-12"
  createdAt    DateTime @default(now())
}

model Event {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  title        String
  emoji        String   @default("📅")
  date         DateTime
  time         String?
  color        String?
  notes        String?
  assignedToId String?
  assignedTo   Member?  @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
}

model Reward {
  id             String       @id @default(cuid())
  familyId       String
  family         Family       @relation(fields: [familyId], references: [id])
  name           String
  emoji          String       @default("🎁")
  cost           Int
  description    String?
  availableCount Int?
  redemptions    Redemption[]
  createdAt      DateTime     @default(now())
}

model Redemption {
  id        String   @id @default(cuid())
  familyId  String
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  text      String?
  mediaUrl  String?
  mediaType String?
  replyToId String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Quest {
  id          String    @id @default(cuid())
  familyId    String
  family      Family    @relation(fields: [familyId], references: [id])
  title       String
  description String?
  emoji       String    @default("⚔️")
  type        String    @default("family")            // "family" | "individual"
  goal        Int       @default(5)
  progress    Int       @default(0)
  reward      Int       @default(10)
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  memberId  String?
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Smart automations (Pro tier) ──────────────────────────────────────────────
// e.g. "if chore not done by 7pm → notify assignee"
model Automation {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id])
  name       String
  trigger    String                                   // "chore_overdue" | "stars_milestone" | "schedule"
  conditions Json     @default("{}")                  // { choreId?, memberId?, time?, threshold? }
  actions    Json     @default("[]")                  // [{ type: "notify", to: "assignee", message: "..." }]
  active     Boolean  @default(true)
  lastRanAt  DateTime?
  createdAt  DateTime @default(now())
}

// ── Family memory timeline (Pro tier) ─────────────────────────────────────────
model Memory {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  title     String
  body      String?
  mediaUrl  String?
  mediaType String?                                   // "image" | "video"
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}