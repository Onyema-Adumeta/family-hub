# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/familyhub"
# Long random string. Changing it signs everyone out.
JWT_SECRET="change-me-to-a-long-random-string"
# Encrypts Google Calendar tokens in the database. Long random string; keep it
# safe — if it is lost, families have to reconnect Google Calendar.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
PORT=3001
CLIENT_URL="http://localhost:5173"
# Where links in emails point (the web app address).
APP_URL="http://localhost:5173"
# Shown to families in Settings → Plan & help.
SUPPORT_EMAIL="you@example.com"

# ── Email (confirmations and password resets) ───────────────────────────────
# Free with Gmail: turn on 2-Step Verification, create an App password,
# then use it below. See docs/OPERATIONS.md section 2.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="yourname@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Kinroost <yourname@gmail.com>"

# ── Optional: AI features (also need a parent to switch AI on in Settings) ──
ANTHROPIC_API_KEY=""

# ── Optional: Google Calendar ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/events/google/callback"
GOOGLE_CALENDAR_ID="primary"
FRONTEND_URL="http://localhost:5173"

# ── Optional: chore photos (Cloudinary) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Optional: browser push notifications ────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

UPLOAD_DIR="./uploads"

# ── Tests only (never set in production) ────────────────────────────────────
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familyhub_test"
